<?xml version="1.0" encoding="UTF-8"?>
<oor:component-data xmlns:oor="http://openoffice.org/2001/registry"
                    xmlns:xs="http://www.w3.org/2001/XMLSchema"
                    oor:name="Addons" oor:package="org.openoffice.Office">
  <node oor:name="AddonUI">

    <node oor:name="OfficeMenuBar">
      <node oor:name="com.innse.servicereport.menu" oor:op="replace">
        <prop oor:name="Title" oor:type="xs:string">
          <value>Raport ~serwisowy</value>
        </prop>
        <prop oor:name="Context" oor:type="xs:string">
          <value>com.sun.star.text.TextDocument</value>
        </prop>
        <node oor:name="Submenu">
          <node oor:name="m01" oor:op="replace">
            <prop oor:name="URL"><value>service:com.innse.servicereport.Job?new</value></prop>
            <prop oor:name="Title"><value>~Nowy raport…</value></prop>
            <prop oor:name="Target"><value>_self</value></prop>
          </node>
          <node oor:name="m02" oor:op="replace">
            <prop oor:name="URL"><value>service:com.innse.servicereport.Job?export</value></prop>
            <prop oor:name="Title"><value>~Zapisz i eksportuj PDF</value></prop>
            <prop oor:name="Target"><value>_self</value></prop>
          </node>
          <node oor:name="m03" oor:op="replace">
            <prop oor:name="URL"><value>private:separator</value></prop>
          </node>
          <node oor:name="m04" oor:op="replace">
            <prop oor:name="URL"><value>service:com.innse.servicereport.Job?phrases</value></prop>
            <prop oor:name="Title"><value>~Biblioteka fraz…</value></prop>
            <prop oor:name="Target"><value>_self</value></prop>
          </node>
          <node oor:name="m05" oor:op="replace">
            <prop oor:name="URL"><value>service:com.innse.servicereport.Job?settings</value></prop>
            <prop oor:name="Title"><value>U~stawienia…</value></prop>
            <prop oor:name="Target"><value>_self</value></prop>
          </node>
          <node oor:name="m06" oor:op="replace">
            <prop oor:name="URL"><value>private:separator</value></prop>
          </node>
          <node oor:name="m07" oor:op="replace">
            <prop oor:name="URL"><value>service:com.innse.servicereport.Job?help</value></prop>
            <prop oor:name="Title"><value>~Pomoc</value></prop>
            <prop oor:name="Target"><value>_self</value></prop>
          </node>
        </node>
      </node>
    </node>

    <node oor:name="OfficeToolBar">
      <node oor:name="com.innse.servicereport.toolbar" oor:op="replace">
        <prop oor:name="Title" oor:type="xs:string">
          <value>Raport serwisowy</value>
        </prop>
        <node oor:name="t01" oor:op="replace">
          <prop oor:name="URL"><value>service:com.innse.servicereport.Job?new</value></prop>
          <prop oor:name="Title"><value>Utwórz raport serwisowy</value></prop>
          <prop oor:name="Target"><value>_self</value></prop>
          <prop oor:name="Context"><value>com.sun.star.text.TextDocument</value></prop>
        </node>
        <node oor:name="t02" oor:op="replace">
          <prop oor:name="URL"><value>service:com.innse.servicereport.Job?export</value></prop>
          <prop oor:name="Title"><value>Zapisz i eksportuj PDF</value></prop>
          <prop oor:name="Target"><value>_self</value></prop>
          <prop oor:name="Context"><value>com.sun.star.text.TextDocument</value></prop>
        </node>
        <node oor:name="t03" oor:op="replace">
          <prop oor:name="URL"><value>service:com.innse.servicereport.Job?phrases</value></prop>
          <prop oor:name="Title"><value>Biblioteka fraz</value></prop>
          <prop oor:name="Target"><value>_self</value></prop>
          <prop oor:name="Context"><value>com.sun.star.text.TextDocument</value></prop>
        </node>
      </node>
    </node>

  </node>
</oor:component-data>
